[Unit]
Description=model-runner: the selected model recipe on one or two DGX Sparks
Documentation=file:///opt/model-runner/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Rate limit only; MAX_START_ATTEMPTS in model-runner bounds the total.
StartLimitIntervalSec=2400
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
# Replaced by install.sh with the installing account.
User=operator
WorkingDirectory=/opt/model-runner

ExecStart=/opt/model-runner/model-runner _exec-start
ExecStop=/opt/model-runner/model-runner _exec-stop

# Runs after a failed start too, when systemd skips ExecStop.
ExecStopPost=/opt/model-runner/model-runner _cleanup

# Exit 75: model-runner gave up after MAX_START_ATTEMPTS.
Restart=on-failure
RestartSec=90
RestartPreventExitStatus=75

# Above the launchers' own 3600 s readiness timeout.
TimeoutStartSec=4500
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
