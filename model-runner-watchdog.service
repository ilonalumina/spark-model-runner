# One health check of the running recipe; restarts model-runner.service after repeated failures.
# Pause with: sudo systemctl stop model-runner-watchdog.timer
[Unit]
Description=model-runner watchdog tick
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/model-runner
ExecStart=/opt/model-runner/model-runner _watch
# An unhealthy check is not a unit failure.
SuccessExitStatus=1
TimeoutStartSec=60
